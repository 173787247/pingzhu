{
  "name": "@173787247/pingzhu-engine",
  "version": "0.10.0",
  "description": "Bopomofo (注音) input method engine — reading grid, Viterbi decoder, candidate ordering, Traditional/Simplified output",
  "license": "MIT",
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],

  "keywords": [
    "bopomofo",
    "zhuyin",
    "注音",
    "input-method",
    "ime",
    "chinese",
    "traditional-chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/173787247/pingzhu.git",
    "directory": "engine"
  },
  "homepage": "https://github.com/173787247/pingzhu",

  "engines": {
    "node": ">=18"
  },

  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-data.mjs",
    "prepublishOnly": "npm run build",
    "demo": "node cli.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },

  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
