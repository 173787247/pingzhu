# third-party source data (fetch with data/fetch-source.sh, ~4.3 MB)
data/vendor/

# generated artefacts that are machine-specific
node_modules/
*.log
.DS_Store

# research scratch (raw crawls live outside the repo under ~/GO/raw)
research/raw/
research/parts/
# upstream file kept only for local cross-checking; reproducible from McBopomofo
research/data/BPMFMappings.txt

# Working notes for whoever picks this project up next — current state, next
# steps, and the machine-specific details (paths, proxy, credentials setup) that
# do not belong in a public repository. Written for an agent, not for a reader
# of the project, so they stay on disk and out of the repo.
#
# HANDOFF-*.md is a pattern on purpose: the convention is that a file named that
# way is a working note, so the next one is covered without anyone remembering
# to add it here. Anything meant to be read by users belongs under docs/ with a
# number, like the design documents already there.
START-HERE.md
docs/HANDOFF-*.md

# editor
.vscode/
.idea/

# Rust build output
core-rs/target/
android/rust/target/
demo/engine/
# copied next to the demo page by .github/workflows/pages.yml for the Pages
# deployment; the one copy that is committed lives in data/
demo/data/

# Windows build staging lives outside the repo; nothing here to ignore
dist/

# CMake's out-of-tree directory for the Debian package: debian/rules creates it
# with `cmake -S linux/fcitx5 -B build-deb`, so cutting a release leaves 15 MB
# of it behind, untracked, every time.
build-deb/

# Python bytecode from the tooling in tools/ and research/tools/
__pycache__/
*.pyc
